# Copy this file to .env and fill in your Gmail App Password.
# A normal Google password will NOT work.
#
# How to get an App Password:
#   1. Google Account -> Security -> 2-Step Verification (enable it)
#   2. Google Account -> Security -> App passwords
#   3. Create one for "Mail" and copy the 16 characters (no spaces)
#
# The .env file is ignored by git and is loaded automatically by app.py.

GMAIL_ADDRESS=kanu6a6y@gmail.com
GMAIL_APP_PASSWORD=

# email = code delivered only to the account email (server screen shows nothing)
# demo  = code shown in the terminal + testing banner (useful for offline demos)
OTP_DELIVERY=email

# Optional: a fixed Flask session secret (random per start if omitted)
# SECRET_KEY=change-me-to-a-long-random-string
