# Local environment configuration for Secure Login System
# Never commit real credentials to source control.

SECRET_KEY=replace-with-a-long-random-value
APP_ENV=development
DEMO_MODE=true
# Show the 6-digit code on the verification/reset page when SMTP fails.
DEMO_SHOW_OTP=true
DEMO_ACCOUNT_USERNAME=demo
DEMO_ACCOUNT_PASSWORD=Demo@1234
HOST=127.0.0.1
PORT=5055
DATABASE_PATH=database.db

# One-time code lifetime / abuse controls
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PENDING_TTL_SECONDS=900
RESET_TTL_SECONDS=600
RESET_MAX_ATTEMPTS=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# Gmail SMTP (use a Google App Password, not your normal password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_NAME=Secure Login System
OTP_RECIPIENT_OVERRIDE=your-address@gmail.com
MAIL_TIMEOUT=12
