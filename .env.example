# Copy this file to .env and configure one SMTP provider.
# .env is ignored by git and is loaded automatically by the app.
#
# Option A - Gmail (needs a 16-character App Password, NOT your normal password):
#   1. Google Account -> Security -> 2-Step Verification (enable it)
#   2. Google Account -> Security -> App passwords -> create one for Mail
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=ssl
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
#
# Option B - Ethereal (free test inbox, view at https://ethereal.email):
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#   SMTP_SECURE=starttls
#   SMTP_USER=your-user@ethereal.email
#   SMTP_PASS=your-ethereal-password
#   SMTP_FROM=your-user@ethereal.email

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=your-user@ethereal.email
SMTP_PASS=
SMTP_FROM=your-user@ethereal.email

# email = code delivered only to the account email (server screen shows nothing)
# demo  = code shown in the terminal + testing banner (useful for offline demos)
OTP_DELIVERY=email

# Optional: a fixed Flask session secret (random per start if omitted)
# SECRET_KEY=change-me-to-a-long-random-string
